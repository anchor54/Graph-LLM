# Database connection string
# For local development (Supabase local): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For production (Supabase hosted): postgresql://user:password@host:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:port/database"

# Direct connection for migrations (if using connection pooling in DATABASE_URL)
# For local development: same as DATABASE_URL
# For production: postgresql://user:password@host:5432/postgres
DIRECT_URL="postgresql://user:password@host:port/database"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Supabase API URL and Anon Key
# For local development: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
