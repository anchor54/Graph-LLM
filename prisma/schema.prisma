generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id         String      @id
  email      String      @unique
  createdAt  DateTime    @default(now())
  nodes      Node[]
  folders    Folder[]
  userModels UserModel[]
}

model Node {
  id            String   @id @default(uuid())
  parentId      String?
  parent        Node?    @relation("Tree", fields: [parentId], references: [id])
  children      Node[]   @relation("Tree")
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  summary       String?
  userPrompt    String
  aiResponse    String?
  modelMetadata Json?
  references    Json?    // Stores array of { id, type, name } used as context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nodes     Node[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id          String      @id @default(uuid())
  provider    String      // 'gemini' or 'openai'
  name        String      // e.g., 'gpt-4o', 'gemini-2.5-flash'
  displayName String
  enabled     Boolean     @default(true)
  isGlobal    Boolean     @default(true) // Global model available to all
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userModels  UserModel[]

  @@unique([provider, name])
  @@index([provider, enabled])
}

model UserModel {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true) // User-specific override
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, modelId])
  @@index([userId])
}
